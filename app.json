{
  "expo": {
    "name": "Aora-app",
    "slug": "aora-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aora-app",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "package": "com.dlysachenko.aora"
    },
    "android": {
      "package": "com.dlysachenko.aora"
    },

    "plugins": ["expo-router",[
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true
  }
}
