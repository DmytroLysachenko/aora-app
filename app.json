{
  "expo": {
    "name": "Aora-app",
    "slug": "aora-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aora-app",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "package": "com.dlysachenko.aora",
      "bundler": "metro"
    },
    "android": {
      "package": "com.dlysachenko.aora",
      "bundler": "metro"
    },
    "web": {
      "bundler": "metro"
    },

    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true
  }
}
